# Copy this file to .env (or .env.local) and change the values.
# .env* files are ignored by git. Never put secrets here:
# everything starting with NEXT_PUBLIC_ is built into the site's files and anyone can read it in the browser.

# Base URL of the backend API, without /api/v1 (it is added; given with it, it is cut off)
NEXT_PUBLIC_API_URL=http://localhost:8000

# true  = fake data in the browser (each feature's mock.ts), while the backend is not ready
# false = call the real API
# Restart `npm run dev` after changing this.
NEXT_PUBLIC_USE_MOCK=true

# The backend's Web Push public key (VAPID; a public value, not a secret), so alerts reach phones while the app is
# closed. Leave it empty until the backend sends push (docs/backend.md, "Push notifications"). Without it the open
# app still plays a sound and shows a notification for new messages and notifications.
NEXT_PUBLIC_PUSH_PUBLIC_KEY=
