# Copy this file to .env and change the values.
# .env is ignored by git. Never put secrets here:
# everything starting with VITE_ is built into the site's files and anyone can read it in the browser.

# Base URL of the backend API, without /api/v1 (it is added; given with it, it is cut off)
VITE_API_URL=http://localhost:8000

# true  = fake data in the browser (each feature's mock.ts), while the backend is not ready
# false = call the real API
# Restart `npm run dev` after changing this.
VITE_USE_MOCK=true
